{
  "name": "orchard-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync:tokens": "node scripts/sync-token-list.mjs",
    "package": "npm run build && rm -f orchard-wallet.zip && cd dist && zip -qr ../orchard-wallet.zip . -x '*.DS_Store' && cd .. && echo \"Packaged dist/ -> orchard-wallet.zip\""
  },
  "dependencies": {
    "@consenlabs/tcx-wasm": "^0.9.1",
    "@pufferfinance/puffer-sdk": "^1.31.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@walletconnect/jsonrpc-utils": "^1.0.8",
    "@walletconnect/sign-client": "^2.23.9",
    "i18next": "^26.2.0",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "viem": "^2.49.2",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.12",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
